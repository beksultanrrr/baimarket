<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Только для отладки: позволяет подсунуть манифест обновлений с
         локального сервера по http (UPDATE_MANIFEST_URL). Android 9+ иначе
         режет любой cleartext молча. В релизную сборку не попадает: каталог
         src/debug применяется только к debug-варианту.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic"/>
</manifest>
